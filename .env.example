# LLM Configuration
# Example models:
# Google: gemini-2.5-flash or gemini-1.5-pro
# OpenAI: gpt-4o-mini or gpt-4o
# Anthropic: claude-3-5-sonnet-20241022 or claude-3-5-haiku-20241022
LLM_MODEL=gemini-2.5-flash
AI_PROVIDER=google

# Provider API Keys (Set at least one depending on your provider)
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Generation Settings
MAX_OUTPUT_TOKENS=1200

# Security & Endpoints
HEALTH_TOKEN=change-me-to-a-secure-random-token

# Features
ENABLE_NEWS=false

# Vnstock timeout in milliseconds
VNSTOCK_TIMEOUT_MS=8000
